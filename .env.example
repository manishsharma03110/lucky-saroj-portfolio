# Hosted Neon production must use its pooled endpoint with sslmode=verify-full.
# Runtime node-postgres requests channel binding where the server supports it.
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=verify-full"
AUTH_SECRET="generate-with: openssl rand -hex 32 (or node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\")"

# Canonical public site origin used for metadata, robots, sitemap, and social cards.
# Set this to the final production origin, with no path or trailing slash.
NEXT_PUBLIC_SITE_URL="https://lucky-saroj-portfolio.vercel.app"

# Dedicated public Vercel Blob store used by CMS media uploads.
# Never commit the real token; configure it as a protected deployment secret.
PORTFOLIO_MEDIA_READ_WRITE_TOKEN=

# Bootstrap-only values used by db:seed when no administrator exists.
# Never commit real values. Use unique production credentials, then rotate or
# remove the bootstrap password from the environment after initial provisioning.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
